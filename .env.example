# ============================================================
# Mercantil Seguros - API de Aliados (ambiente de pruebas)
# Copia este archivo a `.env` y completa los valores reales.
# En Vercel: Settings -> Environment Variables
# ============================================================

# URL base de la API de Aliados (sin slash final)
MERCANTIL_API_URL=https://imajev78v9.execute-api.us-east-2.amazonaws.com/ally-api

# ApiKey asociado a la Plataforma de Aliados Mercantil Seguros
MERCANTIL_API_KEY=tu-api-key-aqui

# Public: URL pública del sitio (para enlaces absolutos si se necesita)
PUBLIC_APP_URL=http://localhost:4321
# URL privada/pública del admin que recibirá emisiones ya confirmadas.
ADMIN_SYNC_URL=http://localhost:3000
# Secreto compartido con FUNNEL_SYNC_SECRET del admin. Sólo servidor.
ADMIN_SYNC_SECRET=
# Recuperación de solicitudes (preparada; desactivada por defecto)
RECOVERY_ENABLED=false
RECOVERY_EMAIL_ENABLED=false
# Base Redis persistente; NO usar almacenamiento efímero de Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 32 bytes aleatorios codificados como 64 caracteres hexadecimales; solo servidor.
RECOVERY_ENCRYPTION_KEY=
# Adaptador de correo preparado para Resend. Destinatario interno fijo, nunca tomado del browser.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
RECOVERY_NOTIFY_TO=
# Autorización del procesador; no se ha programado ningún cron.
CRON_SECRET=
# Código de la campaña del admin a la que pertenece este funnel (origen de cartera y ejecutivo).
ADMIN_CAMPAIGN_CODE=funnel-mercantil-vitales
